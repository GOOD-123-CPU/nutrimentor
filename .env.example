# ============================================================
# NutriMentor environment configuration
# 1. Copy this file:            cp .env.example .env
# 2. Fill in your own keys.     NEVER commit the real .env file.
# 3. Get a DeepSeek API key:    https://platform.deepseek.com/
#    Get a PubMed API key (optional, free):
#      https://www.ncbi.nlm.nih.gov/books/NBK25500/
# ============================================================

# --- LLM provider (required) ---
# Any OpenAI-compatible chat API works: DeepSeek, OpenAI, vLLM, Ollama, etc.
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- Embedding model ---
# Either a local path (auto-downloaded by scripts/download_model.py)
# or a HuggingFace model id, e.g. BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_PATH=models/bge-large-zh
EMBEDDING_DEVICE=auto          # auto | cpu | cuda | mps

# --- Retrieval ---
RETRIEVAL_K=8                  # documents fetched per query
MAX_CONTEXT_DOCS=5             # documents fed into the prompt
WORD_DOC_PRIORITY=4            # how many Word/Markdown doc slots to reserve

# --- Server ---
HOST=127.0.0.1
PORT=8080
DEBUG=false

# --- Optional: PubMed E-utilities (better rate limits with a key) ---
PUBMED_API_KEY=
PUBMED_TOOL=nutrimentor-demo
PUBMED_EMAIL=you@example.com
